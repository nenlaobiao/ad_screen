/**
 * 引用 Android 系统库，示例如下：
 * import { Context } from "android.content.Context";
 * [可选实现，按需引入]
 */
import { UTSAndroid } from "io.dcloud.uts";
import Context from "android.content.Context";
import AudioManager from "android.media.AudioManager";
import Locale from "java.util.Locale";
import TextToSpeech from "android.speech.tts.TextToSpeech";
import UtteranceProgressListener from "android.speech.tts.UtteranceProgressListener";
/* 引入 interface.uts 文件中定义的变量 */
import { TtsSpeakerOptions, TSpeechOptions } from '../interface.uts';

/**
 * 播报进度监听（ad_screen 本地修改）：播完 / 出错 / 被停止时通知 TtsSpeaker 结束对应的 Promise
 * 回调在 TTS 引擎的后台线程执行
 */
class SpeakProgressListener extends UtteranceProgressListener {
	private owner : TtsSpeaker
	constructor(owner : TtsSpeaker) {
		super()
		this.owner = owner
	}
	override onStart(utteranceId : string | null) : void { }
	override onDone(utteranceId : string | null) : void {
		this.owner.onUtteranceEnd(utteranceId)
	}
	override onError(utteranceId : string | null) : void {
		this.owner.onUtteranceEnd(utteranceId)
	}
	override onStop(utteranceId : string | null, interrupted : boolean) : void {
		this.owner.onUtteranceEnd(utteranceId)
	}
}

export class TtsSpeaker {
	speaker : TextToSpeech | null = null;
	utteranceId = ""; // 一个唯一的ID用于识别utterance
	defaultSpeechRate : number = 1.0; // 默认语速（倍率），1.0 为正常语速
	alwaysPlay : boolean = false; // true=静音也播报，false=静音状态下跳过播报
	private utteranceSeq : number = 0; // 每次播报递增，生成唯一的 utteranceId
	private pendingResolve : (() => void) | null = null; // 当前播报的 Promise 结束函数
	constructor(options : TtsSpeakerOptions) {
		this.defaultSpeechRate = options.speechRate ?? 1.0;
		this.alwaysPlay = options.alwaysPlay ?? false;
		let language = {
			"ZH": Locale.CHINA,
			"EN": Locale.ENGLISH
		}[options.language] as Locale
		const { callback } = options
		const context = UTSAndroid.getAppContext();
		const listener = new TextToSpeech.OnInitListener(function (status : Int) {
			if (status === TextToSpeech.SUCCESS) {
				// 设置语言
				const result = this.speaker?.setLanguage(language);
				if(result === TextToSpeech.LANG_MISSING_DATA){
					callback?.({ success: -1, message: '语言数据丢失' });
				} else if (result === TextToSpeech.LANG_NOT_SUPPORTED) {
					callback?.({ success: -1, message: '不支持该语言' });
				} else {
					// 引擎就绪后应用默认语速
					this.speaker?.setSpeechRate(clampRate(this.defaultSpeechRate));
					callback?.({ success: 0, message: 'TTS 初始化成功' });
				}
			} else {
				callback?.({ success: status as number, message: `TTS 初始化失败（status=${status}，engine=${options.engine ?? '系统默认'}）` });
			}
		});
		// ad_screen 本地修改：可指定引擎包名（如讯飞），没装该引擎时系统会自动回退到默认引擎
		const engine = options.engine ?? '';
		if (engine != '') {
			this.speaker = new TextToSpeech(context, listener, engine);
		} else {
			this.speaker = new TextToSpeech(context, listener);
		}
		this.speaker?.setOnUtteranceProgressListener(new SpeakProgressListener(this));
	}

	/**
	 * 设置默认语速（倍率），1.0 为正常，范围建议 0.5~2.0，越界自动 clamp
	 */
	setSpeechRate(rate : number) : void {
		this.defaultSpeechRate = rate;
		if (this.speaker != null) {
			this.speaker.setSpeechRate(clampRate(rate));
		}
	}

	/**
	 * 判断设备是否处于静音状态（铃声静音/振动，或媒体音量为零）
	 */
	private isDeviceSilent() : boolean {
		const context = UTSAndroid.getAppContext()
		if (context == null) {
			return false
		}
		const audioManager = context.getSystemService(Context.AUDIO_SERVICE) as AudioManager
		if (audioManager == null) {
			return false
		}
		// 铃声静音或振动（RINGER_MODE_NORMAL = 2）
		if (audioManager.getRingerMode() !== AudioManager.RINGER_MODE_NORMAL) {
			return true
		}
		// 媒体音量为零
		if (audioManager.getStreamVolume(AudioManager.STREAM_MUSIC) <= 0) {
			return true
		}
		return false
	}

	/**
	 * 播报一段文本（ad_screen 本地修改：返回的 Promise 在本句播完、出错、
	 * 被 stopSpeech 停止或被下一句打断时才 resolve，可用来判断是否播放完毕）
	 * @param msg 播报文本
	 * @param options 可选，单次临时语速 { speechRate }
	 */
	speechMessage(msg : string, options : TSpeechOptions | null = null): Promise<void> {
		return new Promise<void>((resolve) => {
			// 未开启 alwaysPlay 且设备处于静音状态时，跳过播报
			if (!this.alwaysPlay && this.isDeviceSilent()) {
				console.log('TTS: 设备处于静音状态，已跳过播报（设置 alwaysPlay=true 可强制播报）');
				resolve();
				return;
			}
			const speaker = this.speaker
			if (speaker == null) {
				resolve();
				return;
			}
			// QUEUE_FLUSH 会打断上一句：先结束上一句的 Promise
			this.finishPending(null);
			this.utteranceSeq++;
			const id = `utterance_${this.utteranceSeq}`;
			this.utteranceId = id;
			this.pendingResolve = () => {
				resolve();
			};
			const params = new Map<string, string>();
			// 设置utteranceId以便于识别是哪个任务完成了或出错
			params.set(TextToSpeech.Engine.KEY_PARAM_UTTERANCE_ID, id);
			// 每次播报前设置目标语速（默认或单次覆盖），避免全局状态残留
			const target = options != null && options.speechRate != null ? options.speechRate : this.defaultSpeechRate;
			speaker.setSpeechRate(clampRate(target));
			const result = speaker.speak(msg, TextToSpeech.QUEUE_FLUSH, params);
			// 引擎拒绝播报时不会有进度回调，直接结束
			if (result != TextToSpeech.SUCCESS) {
				this.finishPending(null);
			}
		})
	}
	stopSpeech() {
		this.speaker?.stop()
		this.finishPending(null)
	}

	/** 停止播报并释放 TTS 引擎，之后这个实例不能再用 */
	shutdown() {
		const speaker = this.speaker
		this.speaker = null
		if (speaker != null) {
			speaker.stop()
			speaker.shutdown()
		}
		this.finishPending(null)
	}

	/** 进度监听回调（后台线程）：切回 UI 线程后结束对应的 Promise */
	onUtteranceEnd(utteranceId : string | null) {
		const activity = UTSAndroid.getUniActivity()
		if (activity == null) {
			this.finishPending(utteranceId)
			return
		}
		activity.runOnUiThread(() => {
			this.finishPending(utteranceId)
		})
	}

	/**
	 * 结束当前播报的 Promise
	 * @param utteranceId 传入时只结束对应的那一句（已被打断的旧句子回调会被忽略）；null 表示直接结束当前句
	 */
	private finishPending(utteranceId : string | null) {
		if (utteranceId != null && utteranceId != this.utteranceId) return
		const resolve = this.pendingResolve
		this.pendingResolve = null
		if (resolve != null) resolve()
	}
}

// 语速倍率 clamp 到 [0.5, 2.0]，返回 Float 以匹配原生 setSpeechRate(float) 参数类型
function clampRate(rate : number) : Float {
	return Math.min(2.0, Math.max(0.5, rate)).toFloat();
}