/** 打开串口需要的参数 */
export type OpenOptions = {
	port : string
	baudRate : number
	dataBits : number
	stopBits : number
	parity : number
	flowCon : number
}
/** 寄存器地址 */
export type RegisterMap = {
	/** 设备号 */
	DEVICE_NAME : number;
	/** 水温（单位：℃） */
	WATER_TEMPERATURE : number;
	/** 室温（单位：℃） */
	ROOM_TEMPERATURE : number;
	/** 重量（单位KG） */
	WEIGHT : number;
	/** 当前洗涤阶段 (D22) */
	WASH_PHASE : number;
	/** 故障码寄存器 (D24) */
	FAULT_REGISTER : number;
	/** 液体液位状态 (D48) */
	LIQUID_LEVEL_STATUS : number;
	/** 总时间倒计时 (D19，单位：S) */
	TOTAL_TIME_COUNTDOWN : number;
	/** 洗护模式 (D16)：1 加强洗，3 基础洗 */
	WASH_MODE : number;
	/** 启动任务 (D20)：0x6F 洗护，0xFF 烘干 */
	START_TASK : number;
	/** 开门前消毒倒计时 (D124，单位：S) */
	STERILIZE_COUNTDOWN : number;
	/** 适应阶段倒计时 (D125，单位：S) */
	ADAPT_COUNTDOWN : number;
}

/** 洗涤阶段状态码 (D22) */
export type WashPhase = {
	/** 开门前消毒阶段 */
	PRE_STERILIZE : number;
	/** 开门阶段 */
	DOOR_OPEN_WAITING_FOR_PET : number;
	/** 适应等待阶段 */
	ADAPTATION_WAIT : number;
	/** 清洗冲洗阶段 */
	PRE_WASH_RINSE : number;
	/** 沐浴露护理阶段 */
	SHOWER_GEL_WASH : number;
	/** 清洗冲洗阶段 */
	POST_SHAMPOO_RINSE : number;
	/** 护毛素护理阶段 */
	CONDITIONER_CARE : number;
	/** 清水清理冲洗阶段 */
	FINAL_RINSE : number;
	/** 烘干阶段 */
	DRYING : number;
	/** 烘干后开门阶段 */
	DOOR_OPEN_WAITING_FOR_PICKUP : number;
	/** 消毒阶段 */
	POST_WASH_STERILIZE : number;
	/** 故障反馈阶段 */
	FAULT : number;
	/** 消毒后待机 */
	POST_STERILIZE_STANDBY : number;
	/** 消毒后门未关提醒 */
	POST_STERILIZE_DOOR_OPEN_REMINDER : number;
}

/** 故障代码位标志 (D24) - 可以通过位运算组合 */
export type FaultCode = {
	/** 无故障 */
	NONE : number;
	/** 冷风机故障 */
	COLD_AIR_FAN : number;
	/** 紫外线故障 */
	UV_LIGHT : number;
	/** 浴室照明故障 */
	BATHROOM_LIGHTING : number;
	/** 门锁故障 */
	DOOR_LOCK : number;
	/** 增压泵故障 */
	BOOSTER_PUMP : number;
	/** 热水器故障 */
	WATER_HEATER : number;
	/** 暖风机半功率故障 */
	WARM_AIR_FAN_HALF_POWER : number;
	/** 暖风机全功率故障 */
	WARM_AIR_FAN_FULL_POWER : number;
	/** 急停被按下 */
	EMERGENCY_STOP_PRESSED : number;
	/** 电池低报警 */
	LOW_BATTERY_ALARM : number;
}

/** 液体液位状态 (D48) */
export type LiquidLevelStatus = {
	/** 液位正常 */
	NORMAL : number;
	/** 消毒液低液位 */
	DISINFECTANT_LOW : number;
	/** 沐浴露低液位 */
	SHOWER_GEL_LOW : number;
	/** 护毛素低液位 */
	CONDITIONER_LOW : number;
	/** 消毒液+沐浴露低液位 */
	DISINFECTANT_AND_SHOWER_GEL_LOW : number;
	/** 消毒液+护毛素低液位 */
	DISINFECTANT_AND_CONDITIONER_LOW : number;
	/** 沐浴露+护毛素低液位 */
	SHOWER_GEL_AND_CONDITIONER_LOW : number;
	/** 消毒液+沐浴露+护毛素低液位 */
	ALL_LOW : number;
}

/**
 * 寄存器地址映射表
 * 将业务名称映射到具体的 Modbus 寄存器地址
 */
export const registerMap : RegisterMap = {
	DEVICE_NAME: 700, // 设备号起始地址
	WATER_TEMPERATURE: 36, // 水温 / 管路温度（单位：℃），与旧项目实机一致
	ROOM_TEMPERATURE: 34, // 室温 / 笼内温度（单位：℃），与旧项目实机一致
	WEIGHT: 46, // 重量（单位KG）

	WASH_PHASE: 22,        // 当前洗涤阶段 (D22)
	FAULT_REGISTER: 24,    // 故障码寄存器 (D24)
	LIQUID_LEVEL_STATUS: 48, // 液体液位状态 (D48)
	TOTAL_TIME_COUNTDOWN: 19, // 总时间倒计时（单位：S）

	WASH_MODE: 16,         // 洗护模式 (D16)
	START_TASK: 20,        // 启动任务 (D20)
	STERILIZE_COUNTDOWN: 124, // 开门前消毒倒计时 (D124)
	ADAPT_COUNTDOWN: 125,  // 适应阶段倒计时 (D125)
}


/** 洗涤阶段状态码 (D22) */
export const washPhase : WashPhase = {
	PRE_STERILIZE: 5,                  			// 开门前消毒阶段
	DOOR_OPEN_WAITING_FOR_PET: 10,     			// 开门阶段
	ADAPTATION_WAIT: 15,               			// 适应等待阶段
	PRE_WASH_RINSE: 20,                			// 清洗冲洗阶段
	SHOWER_GEL_WASH: 30,               			// 沐浴露护理阶段
	POST_SHAMPOO_RINSE: 40,            			// 清洗冲洗阶段
	CONDITIONER_CARE: 50,              			// 护毛素护理阶段
	FINAL_RINSE: 60,                   			// 清水清理冲洗阶段
	DRYING: 70,                        			// 烘干阶段
	DOOR_OPEN_WAITING_FOR_PICKUP: 80,  			// 烘干后开门阶段
	POST_WASH_STERILIZE: 90,           			// 消毒阶段
	FAULT: 100,                       			// 故障反馈阶段
	POST_STERILIZE_STANDBY: 110,         		// 消毒后待机
	POST_STERILIZE_DOOR_OPEN_REMINDER: 120, // 消毒后门未关提醒
}

/** 故障代码位标志 (D24) - 可以通过位运算组合 */
export const faultCode : FaultCode = {
	NONE: 0,                           // 无故障
	COLD_AIR_FAN: 1,                   // 冷风机故障
	UV_LIGHT: 2,                       // 紫外线故障
	BATHROOM_LIGHTING: 4,              // 浴室照明故障
	DOOR_LOCK: 8,                      // 门锁故障
	BOOSTER_PUMP: 16,                  // 增压泵故障
	WATER_HEATER: 32,                  // 热水器故障
	WARM_AIR_FAN_HALF_POWER: 64,       // 暖风机半功率故障
	WARM_AIR_FAN_FULL_POWER: 128,      // 暖风机全功率故障
	EMERGENCY_STOP_PRESSED: 256,       // 急停被按下
	LOW_BATTERY_ALARM: 512,            // 电池低报警
}

/** 液体液位状态 (D48) */
export const liquidLevelStatus : LiquidLevelStatus = {
	NORMAL: 0,                               // 液位正常
	DISINFECTANT_LOW: 10,                    // 消毒液低液位
	SHOWER_GEL_LOW: 20,                      // 沐浴露低液位
	CONDITIONER_LOW: 30,                     // 护毛素低液位
	DISINFECTANT_AND_SHOWER_GEL_LOW: 40,     // 消毒液+沐浴露低液位
	DISINFECTANT_AND_CONDITIONER_LOW: 50,    // 消毒液+护毛素低液位
	SHOWER_GEL_AND_CONDITIONER_LOW: 60,    	 // 沐浴露+护毛素低液位
	ALL_LOW: 70,                             // 消毒液+沐浴露+护毛素低液位
}
