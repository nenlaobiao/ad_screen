import { RS232Serial } from '@/uni_modules/shmily-rs232-serial';
// import { RS232Serial } from './mock.uts';
import { checkCRC16 } from "./utils.uts"
import { delay } from "@/utils/tools.uts"

const STORAGE_KEY_LAST_PORT = "LAST_SERIAL_PORT"
/** 接收缓冲区超过该时长没有新数据，视为残帧丢弃（毫秒） */
const RX_STALE_MS : number = 300
/** 最短 Modbus RTU 帧：异常响应 5 字节 */
const MIN_FRAME_BYTES : number = 5
/**
 * RS232 串口管理类（支持 Modbus RTU 自动连接）
 */
export class SerialManager {
	private serialPort : RS232Serial
	private baud : number
	// 存储 tryPort 的 resolve 函数，用于在数据订阅回调中触发成功
	private currentResolve : ((ok : boolean) => void) | null = null
	private testFrame : string
	private tryConnect : boolean // 正在尝试连接的标志
	/** 接收缓冲区（HEX），底层一次 read 可能只拿到半帧，需要拼包 */
	private rxBuffer : string = ''
	/** 最近一次收到数据的时间戳 */
	private rxLastTime : number = 0
	/** 连接成功后的帧回调（只收到完整且 CRC 正确的帧） */
	private frameCallback : ((data : string) => void) | null = null
	/** 帧间静默间隔（毫秒）：3.5 个字符时间（每字符 11 bit）再留 1ms 余量，19200 下为 4ms */
	public intervalMs : number
	/**  连接状态 */
	public connecting : boolean

	constructor(baud : number = 19200, testFrame : string = "010302BC000A0591") {
		this.serialPort = new RS232Serial()
		this.baud = baud
		this.testFrame = testFrame
		this.intervalMs = Math.ceil(3.5 * 11 * 1000 / baud) + 1
		this.tryConnect = false
		this.connecting = false
	}

	/**
	 * 自动扫描串口并尝试连接 Modbus PLC
	 * @returns 是否已连接（连接流程进行中时返回 false）
	 */
	public async autoConnect(timeout = 800) : Promise<boolean> {
		// 防止重复触发连接流程
		if (this.tryConnect || this.connecting) return this.connecting

		this.tryConnect = true
		this.connecting = false // 重置连接状态

		// 订阅数据：插件只保存一个回调，这里统一接管，拼包后再分发（见 dispatchFrame）
		this.rxBuffer = ''
		this.serialPort.subscribe('HEX', (data : string) => {
			this.feedRx(data)
		})

		const ports = this.serialPort.getDeviceList()
		console.log("可用串口列表:", ports)

		// 尝试读取缓存端口
		const lastPort = uni.getStorageSync(STORAGE_KEY_LAST_PORT) as string | null
		if (lastPort != null && ports.includes(lastPort)) {
			if (await this.tryPort(lastPort, timeout)) {
				console.log("✔ 成功连接上次端口:", lastPort)
				this.tryConnect = false
				this.connecting = true
				return true
			}
		}

		// 遍历所有端口尝试连接
		for (const port of ports) {
			const ok = await this.tryPort(port, timeout)
			if (ok) {
				console.log("✔ 成功连接到 Modbus PLC:", port)
				uni.setStorageSync(STORAGE_KEY_LAST_PORT, port) // 缓存成功端口
				this.tryConnect = false
				this.connecting = true
				return true
			}
		}

		// 所有尝试都失败
		this.tryConnect = false
		this.connecting = false
		console.error("未找到可用的 Modbus 设备")
		return false
	}

	/** 尝试打开单个端口并发送测试帧 */
	private tryPort(port : string, timeout : number) : Promise<boolean> {
		const self = this
		let timeoutTimerId : number | null = null
		let initialDelayTimerId : number | null = null

		return new Promise<boolean>(function (resolve : (ok : boolean) => void) {
			console.log(`尝试端口: ${port}`)
			let settled = false

			/**
			 * 统一的 Promise 解决函数，确保只调用一次，并进行资源清理
			 * @param ok 是否成功
			 */
			const finalResolve = (ok : boolean) => {
				if (!settled) {
					settled = true

					// 1. 清除所有定时器
					const tId = timeoutTimerId
					if (tId != null) clearTimeout(tId)
					const dId = initialDelayTimerId
					if (dId != null) clearTimeout(dId)

					// 2. 清除全局 resolve 引用，防止数据订阅回调错误触发
					self.currentResolve = null

					// 3. 健壮性改进：如果连接失败 (ok=false)，必须关闭串口
					if (!ok) {
						try {
							// 只有在串口成功打开后才尝试关闭。如果打开失败，则无需关闭。
							// 但为了安全起见，此处尝试关闭以释放资源。
							self.serialPort.close()
							console.log(`端口 ${port} 尝试失败，已确保关闭。`)
						} catch (e) {
							// 忽略关闭时的错误，因为它可能本来就没打开
							console.warn(`关闭端口 ${port} 时可能发生错误 (可能未成功打开):`, e)
						}
					}

					// 4. 解决 Promise
					resolve(ok)
				}
			}

			// 设置全局 resolve，供数据订阅回调使用
			self.currentResolve = finalResolve

			// 尝试打开串口
			try {
				self.serialPort.open({
					port,
					baudRate: self.baud,
					dataBits: 8,
					stopBits: 1,
					parity: 0,
					flowCon: 0
				})
			} catch (err) {
				console.error(`端口 ${port} 打开失败:`, err)
				// 打开失败，直接 resolve false，不需要再设置超时或发送
				finalResolve(false)
				return
			}

			// 延时发送测试帧，保证串口稳定（80ms 是经验值）
			initialDelayTimerId = setTimeout(function () {
				try {
					self.serialPort.sendHex(self.testFrame)
				} catch (err) {
					console.warn(`端口 ${port} 发送测试帧失败`, err)
					// 发送失败不立即判定失败，等待超时，因为有时打开成功但首次发送会失败
				}
			}, 80)

			// 设置超时处理
			timeoutTimerId = setTimeout(function () {
				console.log(`端口 ${port} 超时未收到响应。`)
				finalResolve(false)
			}, timeout)
		})
	}

	/** 发送 HEX 指令 */
	public async sendHex(frame : string) {
		// 未连接（包括正在扫描端口）时阻止发送
		if (!this.connecting) {
			console.warn("串口未连接，发送操作被阻止。")
			return
		}

		// 新请求发出前清掉上一轮的残留，避免污染本次响应
		if (this.rxBuffer.length > 0) {
			console.warn(`发送前丢弃残留字节: ${this.rxBuffer}`)
			this.rxBuffer = ''
		}

		try {
			this.serialPort.sendHex(frame)
			await delay(this.intervalMs) // 等待 Modbus RTU 静默间隔
		} catch (err) {
			console.error("发送 HEX 指令失败:", err)
		}
	}

	/** 关闭串口 */
	public close() {
		// 先重置状态，关闭失败也不影响后续重连
		this.connecting = false
		this.tryConnect = false // 停止任何尝试连接状态
		this.currentResolve = null // 清除任何悬挂的 resolve
		this.rxBuffer = ''
		try {
			this.serialPort.close()
			console.log("串口已成功关闭。")
		} catch (e) {
			console.error("关闭串口时发生错误:", e)
		}
	}

	/**
	 * 订阅数据：回调只会收到完整且 CRC 正确的帧（连接探测期间的帧不会分发）。
	 * 只保留一个订阅者，由 ModbusQueue 在构造时注册，连接前后都可调用
	 */
	public subscribe(callback : (data : string) => void) {
		this.frameCallback = callback
	}

	/** 底层原始数据入口：追加到缓冲区并尝试切出完整帧 */
	private feedRx(hex : string) {
		const now = Date.now()
		if (this.rxBuffer.length > 0 && now - this.rxLastTime > RX_STALE_MS) {
			console.warn(`丢弃超时残帧: ${this.rxBuffer}`)
			this.rxBuffer = ''
		}
		this.rxLastTime = now
		this.rxBuffer += hex
		this.extractFrames()
	}

	/**
	 * 从缓冲区按功能码推算帧长并切帧：
	 * 长度不够就等下一包；CRC 不对就丢 1 字节重新找帧头
	 */
	private extractFrames() {
		let dropped = ''
		while (this.rxBuffer.length >= MIN_FRAME_BYTES * 2) {
			const len = this.expectedFrameBytes()
			if (len < 0) {
				dropped += this.rxBuffer.substring(0, 2)
				this.rxBuffer = this.rxBuffer.substring(2)
				continue
			}
			if (this.rxBuffer.length < len * 2) break

			const frame = this.rxBuffer.substring(0, len * 2)
			if (checkCRC16(frame)) {
				if (dropped.length > 0) {
					console.warn(`丢弃无效字节: ${dropped}`)
					dropped = ''
				}
				this.rxBuffer = this.rxBuffer.substring(len * 2)
				this.dispatchFrame(frame)
			} else {
				dropped += this.rxBuffer.substring(0, 2)
				this.rxBuffer = this.rxBuffer.substring(2)
			}
		}
		if (dropped.length > 0) {
			console.warn(`丢弃无效字节: ${dropped}`)
		}
	}

	/** 根据缓冲区开头的功能码推算整帧字节数，未知功能码返回 -1 */
	private expectedFrameBytes() : number {
		const fc = parseInt(this.rxBuffer.substring(2, 4), 16)
		if ((fc & 0x80) != 0) return 5 // 异常响应：地址 + 功能码 + 异常码 + CRC
		if (fc >= 1 && fc <= 4) {
			// 读响应：地址 + 功能码 + 字节数 + 数据 + CRC；字节数超过 250 必然是错位
			const byteCount = parseInt(this.rxBuffer.substring(4, 6), 16)
			if (byteCount > 250) return -1
			return 5 + byteCount
		}
		if (fc == 5 || fc == 6 || fc == 15 || fc == 16) return 8 // 写响应：固定 8 字节
		return -1
	}

	/** 分发完整帧：连接探测阶段交给 tryPort，连接后交给订阅者 */
	private dispatchFrame(frame : string) {
		const resolveFunc = this.currentResolve
		if (resolveFunc != null) {
			resolveFunc(true) // 收到有效数据，认为连接成功
			return
		}
		const callback = this.frameCallback
		if (callback != null) {
			callback(frame)
		}
	}

	/** 获取可用端口列表 */
	public getDeviceList() : string[] {
		// 无论是否连接成功，都应该能获取设备列表，但为了保持原代码逻辑，暂时保留限制。
		// 实际应用中，此函数不应受连接状态限制。
		return this.serialPort.getDeviceList()
	}
}

export default new SerialManager()