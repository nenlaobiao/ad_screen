import { toNewObject } from "@/utils/tools.uts"
import { RegisterMap, WashPhase, LiquidLevelStatus, FaultCode } from "./types.uts" 
import type { OpenOptions } from "./types.uts"

//设备号
const DeviceCode : string = '15294'

/**
 * Mock RS232Serial
 * 真正模拟 Modbus RTU 从站（寄存器基于数字数组）
 */
export class RS232Serial {

	private isOpened : boolean = false
	private callback : ((data : string) => void) | null = null

	/** 模拟 D 区寄存器（每个元素 = 1 个 16bit 寄存器） */
	private registers : number[] = []

	constructor() {
		this.initRegisters()
	}

	/** 初始化寄存器并写入默认值 */
	private initRegisters() {
		// 1. 初始化所有寄存器为 0
		for (let i = 0; i < 800; i++) {
			this.registers.push(0)
		}

		// 2. 写入特定的、有意义的默认值
		// 这样配置非常清晰，一眼就能看出每个寄存器的初始状态
		console.log('[ serialMock ] --> 正在初始化并写入默认寄存器值...')
		this.writeRegister(RegisterMap.WATER_TEMPERATURE, 32.5);              // 设置默认水温 32.5°C
		this.writeRegister(RegisterMap.ROOM_TEMPERATURE, 25);                 // 设置默认室温 25°C
		this.writeRegister(RegisterMap.WEIGHT, 15);                           // 设置默认重量 15KG
		this.writeRegister(RegisterMap.LIQUID_LEVEL_STATUS, LiquidLevelStatus.NORMAL); // 设置默认液位为 "正常"
		this.writeRegister(RegisterMap.FAULT_REGISTER, FaultCode.NONE);       // 设置默认故障状态为 "无故障"
		this.writeRegister(RegisterMap.WASH_PHASE, WashPhase.POST_STERILIZE_STANDBY);		// 设置默认洗涤阶段为 "消毒后待机"

		// 写入设备序列号 (地址 D700)
		this.writeString(RegisterMap.DEVICE_NAME, DeviceCode)
		console.log('[ serialMock ] --> 默认寄存器值写入成功')
	}

	/**
	 * 写入单个寄存器（16-bit）
	 * @param address 寄存器地址
	 * @param value 要写入的值
	 */
	private writeRegister(address : number, value : number) {
		if (address >= 0 && address < this.registers.length) {
			// console.log(`[ serialMock ] --> 写寄存器 D${address} = ${value}`)
			this.registers[address] = value
		} else {
			console.warn(`[ serialMock ] --> 警告：尝试写入无效的寄存器地址 ${address}`)
		}
	}

	/**
	 * 写入字符串到寄存器
	 * 两个字符占用一个寄存器
	 * 存储格式: LowByte=Char0, HighByte=Char1
	 * Modbus读取(BigEndian)表现为: Char1 Char0
	 */
	private writeString(address : number, str : string) {
		let regIndex = 0
		for (let i = 0; i < str.length; i += 2) {
			const char0 = (str.charCodeAt(i) ?? 0) & 0xFF
			const char1 = (i + 1 < str.length) ? ((str.charCodeAt(i + 1) ?? 0) & 0xFF) : 0
			const value = (char1 << 8) | char0
			this.writeRegister(address + regIndex, value)
			regIndex++
		}
	}

	/** 模拟系统串口列表 */
	public getDeviceList() : string[] {
		return ["/dev/ttyS0", "/dev/ttyS1", "/dev/ttyAMA0"]
	}

	/** 打开串口 */
	public open(options : any) : void {
		const opt = toNewObject<OpenOptions>(options)
		this.isOpened = true
		console.log(`[ serialMock ] --> 串口已打开 ${opt.port}`)
	}

	/** 发送 HEX（Modbus RTU） */
	public sendHex(hex : string) : void {
		if (!this.isOpened) {
			throw new Error("Serial port not opened")
		}

		// console.log(`[ serialMock ] --> TX ${hex}`)

		const bytes = this.hexToBytes(hex)
		const fc = bytes[1]

		// 路由功能码
		if (fc === 0x03) {
			this.handleReadHolding(bytes)
		} else if (fc === 0x06) {
			this.handleWriteSingle(bytes)
		} else if (fc === 0x10) {
			this.handleWriteMultiple(bytes)
		} else {
			console.warn(`[ serialMock ] --> 不支持的功能码 ${fc}`)
		}
	}

	/** 订阅数据 */
	public subscribe(type : string, cb : (data : string) => void) : void {
		if (type === "HEX") {
			this.callback = cb
		}
	}

	/** 关闭串口 */
	public close() : void {
		this.isOpened = false
		this.callback = null
	}

	// ------------------------------------------------------------------
	// Modbus 功能实现
	// ------------------------------------------------------------------

	/** 03 读保持寄存器 */
	private handleReadHolding(req : number[]) {
		const slave = req[0]
		const start = (req[2] << 8) | req[3]
		const count = (req[4] << 8) | req[5]

		const payload : number[] = []

		for (let i = 0; i < count; i++) {
			const value = this.registers[start + i] ?? 0
			payload.push((value >> 8) & 0xFF) // 高位
			payload.push(value & 0xFF)        // 低位
		}

		const res : number[] = [
			slave,
			0x03,
			payload.length,
			...payload
		]

		this.appendAndSend(res)
	}

	/** 06 写单个保持寄存器 */
	private handleWriteSingle(req : number[]) {
		const slave = req[0]
		const address = (req[2] << 8) | req[3]
		const value = (req[4] << 8) | req[5]

		this.writeRegister(address, value)

		// 06 的响应 = 原样回显请求（含 CRC）
		const res : number[] = [
			slave,
			0x06,
			req[2],
			req[3],
			req[4],
			req[5]
		]

		this.appendAndSend(res)
	}

	/** 10 写多个寄存器 */
	private handleWriteMultiple(req : number[]) {
		const slave = req[0]
		const start = (req[2] << 8) | req[3]
		const count = (req[4] << 8) | req[5]

		let offset = 7
		for (let i = 0; i < count; i++) {
			const hi = req[offset++]
			const lo = req[offset++]
			const value = (hi << 8) | lo
			this.writeRegister(start + i, value) // 使用辅助函数写入
		}

		// 写成功响应
		const res : number[] = [
			slave,
			0x10,
			(req[2]),
			(req[3]),
			(req[4]),
			(req[5])
		]

		this.appendAndSend(res)
	}

	// ------------------------------------------------------------------
	// 工具方法
	// ------------------------------------------------------------------

	private appendAndSend(bytes : number[]) {
		const crc = this.calcCRC(bytes)
		bytes.push(crc & 0xff, (crc >> 8) & 0xff)

		const hex = this.bytesToHex(bytes)

		setTimeout(() => {
			// console.log(`[ serialMock ] --> RX ${hex}`)
			if (this.callback != null) {
				this.callback(hex)
			}
		}, 10)
	}

	private hexToBytes(hex : string) : number[] {
		const arr : number[] = []
		for (let i = 0; i < hex.length; i += 2) {
			const sub = hex.substring(i, i + 2)
			arr.push(parseInt(sub, 16))
		}
		return arr
	}

	private bytesToHex(bytes : number[]) : string {
		return bytes.map(b => b.toString(16).padStart(2, "0")).join("").toUpperCase()
	}

	/** CRC16-Modbus */
	private calcCRC(data : number[]) : number {
		let crc = 0xFFFF
		for (let b of data) {
			crc ^= b
			for (let i = 0; i < 8; i++) {
				if ((crc & 1) == 1) crc = (crc >> 1) ^ 0xA001
				else crc >>= 1
			}
		}
		return crc
	}
}