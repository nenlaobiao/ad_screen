import serialManager from './serial.uts'
import { getExceptionCode, isResponseFor } from './utils.uts'

/** 单次发送等待应答的超时（毫秒） */
const TASK_TIMEOUT_MS : number = 1500
/** 每条请求最多发送次数（含首次） */
const MAX_ATTEMPTS : number = 3
/** 连续多少条请求最终失败，判定设备掉线 */
const OFFLINE_THRESHOLD : number = 3

/** 收发旁路监听：每次发送的结果都会回调（超时 response 为空、success 为 false） */
export type TrafficListener = (command : string, response : string, success : boolean) => void

/** 队列中的一条请求 */
class QueueTask {
	/** 完整请求帧（含 CRC） */
	frame : string
	/** 请求结束回调：成功为应答帧，失败为 null */
	resolve : (response : string | null) => void
	/** 已发送次数 */
	attempts : number = 0

	constructor(frame : string, resolve : (response : string | null) => void) {
		this.frame = frame
		this.resolve = resolve
	}
}

/**
 * Modbus RTU 请求队列：一问一答串行发送，负责应答匹配、超时与重试
 */
export class ModbusQueue {
	private list : QueueTask[] = []
	/** 正在等待应答的请求 */
	private current : QueueTask | null = null
	/** 超时定时器 ID */
	private timeoutId : number | null = null
	/** 连续最终失败的请求数，收到任何应答即清零 */
	private failStreak : number = 0

	/** 调试用：旁路查看每次收发结果 */
	public onTraffic : TrafficListener | null = null
	/** 连续失败达到阈值时回调，由上层决定是否重连 */
	public onOffline : (() => void) | null = null

	constructor() {
		serialManager.subscribe((frame : string) => {
			this.handleFrame(frame)
		})
	}

	/**
	 * 发送一条请求并等待应答
	 * @param frame 完整请求帧（含 CRC），可用 buildReadFrame / buildWriteFrame 生成
	 * @returns 应答帧；超时重试仍失败、设备返回异常码或串口未连接时为 null
	 */
	public request(frame : string) : Promise<string | null> {
		return new Promise<string | null>((resolve : (response : string | null) => void) => {
			if (!serialManager.connecting || frame.length == 0) {
				resolve(null)
				return
			}
			this.list.push(new QueueTask(frame, resolve))
			this.next()
		})
	}

	/** 队列是否空闲（无待发请求且不在等待应答） */
	public isIdle() : boolean {
		return this.current == null && this.list.length == 0
	}

	/** 清空队列，未完成的请求全部以 null 结束 */
	public clear() {
		this.clearTimer()
		const task = this.current
		const pending = this.list
		this.current = null
		this.list = []
		if (task != null) task.resolve(null)
		for (const item of pending) {
			item.resolve(null)
		}
	}

	/** 取队首请求发送（当前有请求在等待应答时不动） */
	private next() {
		if (this.current != null || this.list.length == 0) return
		if (!serialManager.connecting) {
			this.clear()
			return
		}
		const task = this.list.shift()!
		this.current = task
		this.send(task)
	}

	private send(task : QueueTask) {
		task.attempts++
		this.timeoutId = setTimeout(() => {
			this.handleTimeout(task)
		}, TASK_TIMEOUT_MS)
		// sendHex 内部会先清空接收缓冲区，发送后等待 RTU 静默间隔
		serialManager.sendHex(task.frame)
	}

	/** 收到一帧完整数据（已通过 CRC） */
	private handleFrame(frame : string) {
		const task = this.current
		if (task == null) {
			console.warn(`没有等待中的请求，丢弃应答: ${frame}`)
			return
		}
		if (!isResponseFor(task.frame, frame)) {
			console.warn(`应答与请求不匹配，丢弃: ${task.frame} <- ${frame}`)
			return
		}
		this.clearTimer()
		this.failStreak = 0 // 设备有应答（包括异常应答）即视为在线
		this.emitTraffic(task.frame, frame, true)

		const code = getExceptionCode(frame)
		if (code >= 0) {
			console.warn(`设备返回异常码 ${code}: ${task.frame}`)
			this.finish(task, null)
			return
		}
		this.finish(task, frame)
	}

	private handleTimeout(task : QueueTask) {
		this.timeoutId = null
		if (this.current != task) return

		console.log(`任务超时: ${task.frame}（第 ${task.attempts} 次）`)
		this.emitTraffic(task.frame, '', false)

		if (task.attempts < MAX_ATTEMPTS) {
			// 隔一个静默间隔重发；期间若迟到的应答先到，current 已变，不再重发
			setTimeout(() => {
				if (this.current == task) this.send(task)
			}, serialManager.intervalMs)
			return
		}

		console.warn(`任务 ${task.frame} 发送 ${MAX_ATTEMPTS} 次均无应答，跳过`)
		this.finish(task, null)
		this.failStreak++
		if (this.failStreak >= OFFLINE_THRESHOLD) {
			this.failStreak = 0
			console.error("=== 连续多次通信失败，可能设备掉线 ===")
			const callback = this.onOffline
			if (callback != null) callback()
		}
	}

	/** 结束请求并回调结果，隔一个静默间隔再发下一条 */
	private finish(task : QueueTask, response : string | null) {
		this.current = null
		task.resolve(response)
		setTimeout(() => {
			this.next()
		}, serialManager.intervalMs)
	}

	private clearTimer() {
		const timerId = this.timeoutId
		if (timerId != null) {
			clearTimeout(timerId)
			this.timeoutId = null
		}
	}

	private emitTraffic(command : string, response : string, success : boolean) {
		const callback = this.onTraffic
		if (callback != null) callback(command, response, success)
	}
}

export default new ModbusQueue()
