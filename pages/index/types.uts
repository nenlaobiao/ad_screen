
export type AdItem = {
	id : number;
	title : string;
	src : string;
	type : 'video' | 'image';
	/** 图片广告停留时长（秒），服务器下发，不传默认 10 秒 */
	duration ?: number;
}
export type State = {
	adList : AdItem[];
}
export type GetMediaInfo = GetImageInfoSuccess | GetVideoInfoSuccess | null | false

export type dFile = {
	data : AdItem;
	path : string;
	fileName : string;
	mediaInfo : GetMediaInfo
}
