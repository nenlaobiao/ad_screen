<script setup lang="uts">
	import { toNewObject, toNewArray} from "@/utils/tools.uts"
	import { globalState } from "@/store/index.uts"
	import { getWashView } from "@/wash/index.uts"
	import type { WashView } from "@/wash/index.uts"
	/** 右侧显示内容：套餐页 / 状态卡 / 洗护步骤，随设备状态切换 */
	const washView = computed<WashView>(() : WashView => getWashView())

	onLoad(() => {
	})
</script>

<template>
	<view class="content">
		<image class="content-bg" src="/static/BG/BG.png" />
		<!-- 左上角温度监控 -->
		<c-temp />
		<view class="content-box">

			<!-- 左侧广告 -->
			<view class="adBox">
				<!-- 服务器下发广告前先播放本地测试数据 -->
				<c-ad :list="globalState.adList" />
			</view>

			<view class="rightBox">

				<!-- 套餐、商品（一直挂载，洗护中被下面的状态卡 / 步骤页盖住） -->
				<c-pay-goods />

				<!-- 设备状态 -->
				<c-status-card v-if="washView.type == 'card'" :status="washView.card" :tips="washView.tips"
					:seconds="washView.seconds" />

				<!-- 洗护进度 -->
				<c-wash-progress v-if="washView.type == 'progress'" :status="globalState.deviceData.status"
					:seconds="washView.seconds" />

				<!-- 测试模块 -->
				<!-- <c-demo v-if="true" /> -->
			</view>

		</view>
		<!-- 网络故障：只在待机显示套餐页时遮住广告和套餐，暂停使用；洗护中不打断（沿用旧版） -->
		<view v-if="!globalState.networkConnected && washView.type == 'pay'" class="network-error">
			<view class="network-error-card">
				<text class="network-error-title">网络故障，暂停使用</text>
				<text class="network-error-tips">网络恢复后将自动重新连接</text>
			</view>
		</view>
		<!-- 底部状态栏 -->
		<c-statusbar />
		
	</view>
</template>

