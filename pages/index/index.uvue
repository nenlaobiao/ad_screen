<script setup lang="uts">
	import { getDeviceInfo, getGoodsInfo, getTemplate } from '@/api/index.uts'
	import { toNewObject, toNewArray} from "@/utils/tools.uts"
	import fileManage from "@/utils/file.uts"
	import { ossUrl, llbbOssUrl ,aliOssUrl} from "@/config.uts"

	import type { CAdChange } from '@/components/c-ad/types.uts'
	import type { AdItem, State, dFile } from './types.uts'
	import type { TempObject, GoodsClassData } from '@/api/types/tempTypes.uts'
	import type { DeviceInfo } from '@/api/types/deviceInfoTypes.uts'
	import type { Goods } from '@/api/types/goodsTypes.uts'


	const adData : AdItem[] = [
		{
			id: 0,
			title: '图片0',
			src: '/storage/adtest/20250422/cd522b8bb7e294a9cb9990d758caa547.jpg',
			type: 'image'
		},
		{
			id: 1,
			title: '视频1',
			src: '/storage/adtest/20250701/35f9d4cd70cc915667a6889997cecbf7.mp4',
			type: 'video'
		},
		{
			id: 2,
			title: '图片2',
			src: '/storage/adtest/20250701/9258ed6f22a6320cb61e56d152653918.jpg',
			type: 'image'
		},
		{
			id: 3,
			title: '视频3',
			src: '/storage/adtest/20250422/4f0b8a44566c352f97d2e4827305fffc.mp4',
			type: 'video'
		},
		{
			id: 4,
			title: '图片4',
			src: '/storage/adtest/20250422/467e1292eaad45241da2cc2c08a88ca0.jpg',
			type: 'image'
		},
		{
			id: 5,
			title: '视频5',
			src: '/storage/adtest/20250422/529b42daafb97fe3ee6419dc018e83d0.mp4',
			type: 'video'
		},
		{
			id: 6,
			title: '图片6',
			src: '/storage/adtest/20250422/a0e2ae4ee9ef536b5a13363899d8f47d.jpg',
			type: 'image'
		},
		{
			id: 7,
			title: '视频7',
			src: '/storage/adtest/20250422/5856e3bed8a9d2ce1d7071f42610c3be.mp4',
			type: 'video'
		},
		{
			id: 9,
			title: '视频9',
			src: '/storage/adtest/20250422/76eac0e97ccdd564c986cb8c94db39aa.mp4',
			type: 'video'
		},
		{
			id: 8,
			title: '图片8',
			src: '/storage/adtest/20250422/3f35affead1aa8d1de4e97ec74f47841.jpg',
			type: 'image'
		},
		{
			id: 10,
			title: '图片10',
			src: '/storage/adtest/20250422/c049dbbbc59f1344743de1a7ca7ffcde.jpg',
			type: 'image'
		},
		{
			id: 11,
			title: '视频11',
			src: '/storage/adtest/20250422/faa37ff709d15ae2dac610cae67b7d8d.mp4',
			type: 'video'
		}
	]
	const state = reactive<State>({
		machineCode: '15294',
		adList: [],
		goodsList: [],
		petWashInfo: [],
		petWash: null,
		showPay: false,
	})

	function cdn(url : string) : string {
		return ossUrl + url
	}
	function adChange(e : any) {
		// console.log('adChange', e as CAdChange)
	}
	function goodsChange(e : any) {
		// console.log('goodsChange', e as CAdChange)
	}
	function payTap(e : DeviceInfo) {
		state.petWash = e
		state.showPay = true
		console.log('payTap', e.title)
	}
	// 获取商品信息
	async function getGoodsInfoFn(ids : string) {
		try {
			console.log('加载商品推荐')
			let res = await getGoodsInfo({ ids })
			if (res.error == 0) {
				let goodsData = res.data as Goods[]
				if (goodsData.length > 0) {
					let goodsAD : AdItem[] = []
					for (let i = 0; i < goodsData.length; i++) {
						let goods = toNewObject<Goods>(goodsData[i])
						let adItem = {
							id: goods.id,
							src: `https://api-prod-shop.jingxishenghuo1688.com/index/getAliShopImage?image=${goods.image}`,
							type: 'image',
							title: goods.title,
						} as AdItem
						goodsAD.push(adItem)
					}
					fileManage(goodsAD, 'goods').then((res : dFile[]) => {
						state.goodsList = res
					})
				}
			}
		} catch (error) {
			console.log('getGoodsInfoFn --- catch', error)
		}
	}
	// 获取套餐信息
	async function getDeviceInfoFn() {
		try {
			console.log('加载套餐信息')
			let res = await getDeviceInfo()
			if (res.error == 0) {
				let data = toNewArray<DeviceInfo>(res.data)
				state.petWashInfo = data
				state.petWash = data[0]
			}
		} catch (error) {
			console.log('getDeviceInfoFn --- catch', error)
		}
	}
	// 获取装修模板信息
	async function getTemplateFn() {
		try {
			let res = await getTemplate({
				templateId:117
			})
			if (res.error == 0) {
				let resData = toNewObject<TempObject>(res.data)
				let templateData = resData.template.home?.data
				if (templateData != null) {
					// 获取指定组件装修信息
					let templateDataItem = templateData.find(obj => obj.type == 'goodsClass')
					if (templateDataItem != null) {
						// 获取组件内商品数据
						let goodsClassData = toNewObject<GoodsClassData>(templateDataItem.data)
						let ids = goodsClassData.templateList[0].goodsIds
						let adIds = ids.slice(0, 6).map(n => `${n}`).join(',')
						console.log('adIds', adIds)
						getGoodsInfoFn(adIds)
					}
				}
			}
		} catch (error) {
			console.log('getTemplate --- 请求失败', error)
		}
	}
	function payBack() {
		state.showPay = false
	}

	const seconds = 66
	onLoad(() => {
		getTemplateFn()
		getDeviceInfoFn()
		fileManage(adData).then((res : dFile[]) => {
			state.adList = res
		})
	})
</script>

<template>
	<view class="content">
		<image class="content-bg" src="/static/BG/BG.png" />
		<!-- 左上角温度监控 -->
		<c-temp />
		<view class="content-box">

			<!-- 左侧广告 -->
			<view class="adBox">
				<image class="adBox-bg" src="/static/BG/adbg.png" />
				<view class="adBox-box">
					<c-ad :list="state.adList" @change="adChange" />
				</view>
			</view>

			<view class="rightBox">
				<!-- 右上商品广告区域 -->
				<view class="goodsAd" v-show="true">
					<c-goods-ad :list="state.goodsList" @change="goodsChange" />
				</view>

				<!-- 右下付款按钮 -->
				<view class="paybtn" v-show="true">
					<c-pay-btn :list="state.petWashInfo" @onTap="payTap" />
				</view>

				<!-- 套餐支付页 -->
				<c-pay-info v-if="state.showPay" :data="state.petWash" :machineCode="state.machineCode" @back="payBack" />

				<!-- 设备状态 -->
				<c-status-card v-if="false" />

				<!-- 洗护进度 -->
				<c-wash-progress v-if="false" />

				<c-demo v-if="false" />
			</view>

		</view>
		<!-- 底部状态栏 -->
		<c-statusbar />
		
	</view>
</template>

