			}
		}
	}

	.payBoxComp-bg {
		position: absolute;
		border-radius: 18rpx;
		width: 100%;
		height: 100%;
	}

	.payBoxComp-border {
		position: absolute;
		z-index: 12;
		border-radius: 18rpx;
		border: 6rpx solid #fff;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	
	.payBtnBox {
		align-items: center;
		flex-direction: row;
		justify-content: space-between;
		width: 100%;
		height: 100%;
	
		.payBtnBox-item-first {
			margin-left: 0 !important;
		}
	
		.payBtnBox-item {
			flex: 1;
			// width: 352px;
			height: 100%;
			display: flex;
			flex-direction: row;
			align-items:flex-start;
			border-radius: 16rpx;
			padding: 10rpx 12rpx;
			margin-left: 9rpx;
			.textBox {
				position: relative;
				display: flex;
				flex: 1;
				flex-direction: column;
				align-items: flex-start;
				.text-title {
					text-align: left;
					font-size: 13rpx;
					font-weight: bold;
				}
	
				.text-subTitle {
					margin: 3rpx 0;
					font-size: 9rpx;
					text-align: left;
				}
	
				.text-desc {
					height: 19rpx;
					border-radius: 4rpx;
					background-color: #fff;
					padding: 0 4rpx;
					text-align: left;
					line-height: 20rpx;
					font-size: 8rpx;
				}
			}
	
			.payBtnBox-item-image {
				position: absolute;
				z-index: -1;
				right: 8rpx;
