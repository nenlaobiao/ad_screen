<script setup>
	/**
	 * 测试demo
	 */
	import { State } from "./types.uts"
	import serialController from "@/serial/index.uts"
	import modbusQueue from "@/serial/queue.uts"
	import { registerMap } from "@/serial/types.uts"
	import { getTimeHMSMs } from "@/utils/tools.uts"
	import { globalState } from "@/store/index.uts"
	
	const state = reactive<State>({
		isOpen: false,
		logs:[],
		scrollViewId:'',
	})
	// 旁路查看每次收发结果
	modbusQueue.onTraffic = (hex : string, res : string, status : boolean) => {
		console.log('ModbusQueue', hex, res, status)
		// let line = `----------${getTimeHMSMs()}----------`
		// state.logs.push( `发 --> ${hex}`, `收 <-- ${res}`, line )
		// state.scrollViewId = `${line}-${state.logs.length - 1}`
	}
	onUnload(()=>{
		modbusQueue.onTraffic = null
	})
	function autoConnect() {
		serialController.connect()
	}
	function close() {
		serialController.disconnect()
	}
	/** 读洗护模式 D16 */
	async function readWash(){
		const regs = await serialController.read(16, 1)
		console.log('readWash', regs)
	}
	/** 写洗护模式 D16 */
	async function setWash(val:number){
		const ok = await serialController.write(16, val)
		console.log('setWash', val, ok)
	}
	async function getDeviceName() {
		const deviceName = await serialController.readDeviceName()
		console.log('deviceName', deviceName)
	}
	/** 读洗护阶段 D22 */
	async function sendHex() {
		const regs = await serialController.read(registerMap.WASH_PHASE, 1)
		console.log('washPhase', regs)
	}
	/** 连续排队读取多个单寄存器 */
	function pushBatch() {
		const addresses : number[] = [26, 28, 46, 30, 32, 34, 36]
		for (const address of addresses) {
			serialController.read(address, 1).then((regs : number[] | null) => {
				console.log(`D${address}`, regs)
			})
		}
	}
	function closeLog(){
		state.logs = []
		state.scrollViewId = ''
	}
</script>

<template>
	<view class="demo">
		<view class="demo-log">
			<list-view class="demo-log-list" :scroll-into-view="state.scrollViewId" :scroll-with-animation="true">
				<list-item v-for="(text,index) in state.logs" class="log-list-item" type='10' :id="`${text}-${index}`">
					<text class="log-list-item-text" :selectable="true">{{text}}</text>
				</list-item>
			</list-view>
			<button class="demo-btn demo-log-btn" @click="closeLog">closeLog</button>
		</view>
		<view class="demo-btns">
			<button class="demo-btn" @click="autoConnect">autoConnect</button>
			<button class="demo-btn" @click="close">close</button>
			<button class="demo-btn" @click="setWash(1)">setWash 1</button>
			<button class="demo-btn" @click="setWash(2)">setWash 2</button>
			<button class="demo-btn" @click="setWash(3)">setWash 3</button>
			<button class="demo-btn" @click="readWash">readWash</button>
			<button class="demo-btn" @click="getDeviceName">getDeviceName</button>
			<button class="demo-btn" @click="sendHex">sendHex</button>
			<button class="demo-btn" @click="pushBatch">pushBatch</button>
			<button class="demo-btn" @click="globalState.deviceData.cage = 10">globalState(10)</button>
		</view>
	</view>
</template>

<style lang="scss">
	/* 蒸汽模式运行时只支持单个 class 选择器和分组选择器：不要嵌套 */
	.demo {
		height: 100%;
		width: 100%;
		border-radius: 18rpx;
		border: 6rpx solid #fff;
		position: relative;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		background-color: skyblue;
	}

	.demo-btns {
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		flex: 2;
	}

	.demo-btn {
		font-size: 10rpx;
		line-height: 20rpx;
		height: 20rpx;
		border-radius: 20rpx;
		margin-bottom: 4rpx;
	}

	/* 日志区的按钮，和 demo-btn 同时使用，必须写在它后面 */
	.demo-log-btn {
		margin: 4rpx;
	}

	.demo-log {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex: 3;
		height: 100%;
		padding-top: 5rpx;
	}

	.demo-log-list {
		flex: 1;
		width: 90%;
		background: #fff;
		border-radius: 6rpx;
	}

	.log-list-item-text {
		font-size: 10rpx;
		text-align: center;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
