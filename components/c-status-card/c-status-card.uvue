<template>
	<image class="status-card-bg" :src="bgUrl"/>
	<view class="status-card">
		你好
	</view>
</template>

<script setup>
import {State} from "./types.uts"
const state =reactive<State>({
	backgroundType:'default'
})
const bgUrl=computed<string.ImageURIString>(()=>{
	switch (state.backgroundType) {
		case 'default':
			return '/static/BG/wash.png'
		default:
			return '/static/BG/wash.png'
	}
})
</script>

<style lang="scss">
.status-card-bg{
	position: absolute;
	left: 0;
	top: 0;
	border-radius: 18rpx;
	width: 100%;
	height: 100%;
}
.status-card{
	height: 100%;
	width: 100%;
	border-radius: 18rpx;
	border:6rpx solid #fff;
}
</style>