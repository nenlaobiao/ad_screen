<script setup>
	/**
	 * 洗宠机步骤显示
	 */
	import { State, WashMode, WashModeBasis } from "./types.uts"
	import { formatSeconds } from "@/utils/tools.uts"
	const props = defineProps({
		/** 当前洗护阶段 (D22)，到达及已完成的步骤高亮 */
		status: {
			type: Number,
			default: 0
		},
		seconds: {
			type: Number,
			default: 0
		},
	})
	const washMode : WashMode = {
		basis: [
			{
				title: '机器消毒',
				status: 5,
				icon: '/static/status/sterilize.png',
				afoot: true
			},
			{
				title: '喷水清洗',
				status: 20,
				icon: '/static/status/flush.png',
				afoot: false
			},
			{
				title: '喷沐浴露',
				status: 30,
				icon: '/static/status/shower.png',
				afoot: false
			},
			{
				title: '喷水清洗',
				status: 40,
				icon: '/static/status/flush.png',
				afoot: false
			},
			{
				title: '喷护毛素',
				status: 50,
				icon: '/static/status/shower.png',
				afoot: false
			},
			{
				title: '喷水清洗',
				status: 60,
				icon: '/static/status/flush.png',
				afoot: false
			},
			{
				title: '宠物烘干',
				status: 70,
				icon: '/static/status/dry.png',
				afoot: false
			},
		]
	}
	const state = reactive<State>({
	})
	const remainingTime = computed<string>(() : string => formatSeconds(props.seconds as number))
	/** 按当前阶段标记步骤：当前步骤及之前的步骤都打勾（沿用旧版） */
	const steps = computed<WashModeBasis[]>(() : WashModeBasis[] => {
		const status = props.status as number
		const current = washMode.basis.findIndex((item : WashModeBasis) : boolean => item.status == status)
		const list : WashModeBasis[] = []
		for (let i = 0; i < washMode.basis.length; i++) {
			const item = washMode.basis[i]
			list.push({
				title: item.title,
				status: item.status,
				icon: item.icon,
				afoot: i <= current,
			} as WashModeBasis)
		}
		return list
	})
</script>

<template>
	<image class="wash-progress-bg" src="/static/BG/wash.png" />
	<view class="wash-progress">
		<text class="wash-progress-timetitle">洗护时间倒计时</text>
		<text class="wash-progress-time">{{remainingTime}}</text>
		<text class="wash-progress-tips">为保证宠物愉快洗浴，请不要离开，照看好您的宝贝</text>
		<view class="progresBox">
			<!-- 蒸汽模式只支持单个 class 选择器：每个元素用自己的 class，高亮 class 直接加在对应元素上 -->
			<view class="progresBox-item" v-for="(item,index) in steps">
				<image :class="['step-img',{'step-img-afoot':item.afoot}]" :src="item.icon" />
				<text class="step-title">{{item.title}}</text>
				<view :class="['step-index-box',{'step-index-box-afoot':item.afoot}]">
					<image class="step-check" v-if="item.afoot" src="/static/icon/checkmarkempty.png" />
					<text class="step-index" v-else>{{index + 1}}</text>
				</view>
				<view :class="['step-line',{'step-line-last': index == (steps.length - 1)}]" />
			</view>
		</view>
		<text class="wash-progress-error">紧急情况请拍按右上方急停按钮</text>
	</view>
</template>

<style lang="scss">
	.wash-progress-bg {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 10;
		border-radius: 18rpx;
		width: 100%;
		height: 100%;
	}

	.wash-progress {
		height: 100%;
		width: 100%;
		border-radius: 18rpx;
		border: 6rpx solid #fff;
		position: relative;
		z-index: 10;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* 蒸汽模式只支持单个 class 选择器，子元素样式不要嵌套 */
	.wash-progress-timetitle {
		font-size: 20rpx;
		color: #2E87B5;
		font-weight: bold;
		margin-top: 34rpx;
	}

	.wash-progress-time {
		font-size: 28rpx;
		color: #2E87B5;
		margin-top: 4rpx;
		font-weight: bold;
	}

	.wash-progress-tips {
		font-size: 8rpx;
		color: #2E87B5;
		font-weight: bold;
		margin-top: 4rpx;
	}

	.progresBox {
		width: 100%;
		display: flex;
		flex-direction: row;
		justify-content: space-evenly;
		padding: 0 10rpx;
		margin-top: 10rpx;
	}

	.progresBox-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		position: relative;
		overflow: visible;
		flex: 1;
	}

	.step-img {
		height: 34rpx;
		width: 34rpx;
		background-color: #F2FBFF;
		border-radius: 25rpx;
		margin-bottom: 8rpx;
	}

	.step-title {
		font-size: 7rpx;
		font-weight: bold;
		color: #2E87B5;
		margin-bottom: 8rpx;
	}

	.step-index-box {
		height: 12rpx;
		width: 12rpx;
		background-color: #fff;
		border-radius: 12rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 10;
	}

	.step-check {
		height: 6rpx;
		width: 6rpx;
	}

	.step-index {
		line-height: 13rpx;
		font-size: 8rpx;
		font-weight: bold;
		color: #2E87B5;
	}

	.step-line {
		width: 100%;
		border-bottom: 1rpx dashed #2E87B5;
		position: absolute;
		z-index: -10;
		bottom: 5rpx;
		transform: translateX(50%);
	}

	/* 以下状态 class 和基础 class 同时使用，必须写在基础 class 后面才能覆盖 */
	.step-line-last {
		display: none;
	}

	.step-img-afoot {
		background-color: #409ECF;
	}

	.step-index-box-afoot {
		background-color: #2E87B5;
	}

	.wash-progress-error {
		margin-top: 18rpx;
		height: 20rpx;
		padding: 0 10rpx;
		background-color: #DAF0FC;
		border-radius: 10rpx;
		line-height: 21rpx;
		font-size: 10rpx;
		font-weight: bold;
		color: #2E87B5;
	}
</style>