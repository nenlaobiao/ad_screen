<script setup>
	/**
	 * 套餐支付页
	 */
	import type { DeviceInfo } from '@/api/types/deviceInfoTypes.uts'
	import {QRcodeTool,mpWashQrUrl } from "@/config.uts"
	const props = defineProps({
		data: {
			type: Object as DeviceInfo,
			default: () => {}
		},
		machineCode:{
			type: String,
			default: () => ''
		}
	})
	const emits = defineEmits<{
		(e : "back", event : any) : void;
		(e : "open", event : any) : void
	}>()
	function openDevice(){
		console.log('open')
		emits('open',props.data)
	}
	function onBack(){
		emits('back',false)
	}
	const MPQRcode = computed(() => {
		return QRcodeTool + encodeURIComponent(mpWashQrUrl + '?machineCode=' + props.machineCode + '&packageType=' + (
			props.data.batch_type))
	})
</script>

<template>
	<image class="payBoxComp-bg" src="/static/BG/pay.png" />
	<view class="payBoxComp">
		<view class="payBoxComp-back" hover-class="hover-class" @click="onBack"  :hover-stay-time="200">
			<image class="back-icon" src="/static/icon/back.png" mode="aspectFit" />
			<text class="back-text">返回</text>
		</view>
		<view class="payInfo">
			<view class="titleBox">
				<view class="titleBox-line"/>
				<text class="payInfo-title">{{props.data.title}}</text>
				<view class="titleBox-line"/>
			</view>
			<view class="payInfo-subBox">
				<text class="subBox-price">{{(props.data.sub_title).split('，')[0]}}</text>
				<text class="subBox-sub_title">{{(props.data.sub_title).split('，')[1]}}</text>
			</view>
			<text class="payInfo-tips">微信扫码确认订单，支付后开始洗护服务</text>
			<image class="qrcode-image"  @click="openDevice"  :src="MPQRcode"></image>
		</view>
	</view>
</template>

<style lang="scss">
.hover-class {
	transform: translate(1rpx, 1rpx);
}
