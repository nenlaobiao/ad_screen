<script setup lang="uts">
	/**
	 * 蒸汽模式只支持组合式 API：App 生命周期用 onLaunch / onAppShow / onAppHide / onLastPageBackPress / onExit
	 */
	import { launchAppOnBoot, setFullscreen, isDeviceRooted } from '@/uni_modules/ad-native'
	import serialController from '@/serial/index.uts'
	import socketController from '@/websocket/index.uts'
	import washController from '@/wash/index.uts'
	import monitorController from '@/monitor/index.uts'
	import voiceController from '@/voice/index.uts'
	import { globalState } from '@/store/index.uts'
	import { exitApp } from '@/utils/app.uts'
	let firstBackTime = 0
	/** 当前时间刷新定时器（底部状态栏显示），只在前台运行 */
	let clockTimer : number | null = null
	function stopClock() {
		const timerId = clockTimer
		if (timerId != null) {
			clearInterval(timerId)
			clockTimer = null
		}
	}
	function startClock() {
		stopClock()
		globalState.nowTime = Date.now()
		clockTimer = setInterval(() => {
			globalState.nowTime = Date.now()
		}, 1000)
	}
	/** 逐个初始化模块：某个模块出错只打印日志，不影响后面的模块 */
	function initModule(name : string, init : () => void) {
		try {
			init()
			console.log(`[初始化] ${name} 完成`)
		} catch (e) {
			console.error(`[初始化] ${name} 失败`, e)
		}
	}

	onLaunch(() => {
		console.log('App Launch')
		initModule('开机自启', () => { launchAppOnBoot() })
		initModule('Root 检测', () => {
			console.log(isDeviceRooted() ? '设备已root' : 'root未开启')
		})
		// 版本号会随 WebSocket init 上报，服务器据此判断是否需要更新
		initModule('版本号', () => {
			globalState.appVersion = uni.getAppBaseInfo().appVersion ?? '0.0.0'
		})
		// 串口、WebSocket、巡检是核心功能，放在前面初始化
		// 串口控制模块：自动连接 + 队列监听 + 读取数据解析
		initModule('串口', () => { serialController.init() })
		// WebSocket：读到设备号后自动连接，断线自动重连
		initModule('WebSocket', () => { socketController.init() })
		// 设备巡检：网络状态监听、远程重启 / 关闭 / 截屏
		initModule('巡检', () => { monitorController.init() })
		// 洗护流程：跟随串口读到的洗护阶段切换界面、语音提醒和背景音乐
		initModule('洗护流程', () => { washController.init() })
		// 语音播报：TTS 引擎初始化需要时间，提前创建
		initModule('语音', () => { voiceController.init() })
	})

	onAppShow(() => {
		console.log('App Show')
		globalState.appActive = true
		// 回到前台时检查服务器连接，断开则立即重连
		socketController.onAppShow()
		startClock()
		setTimeout(() => {
			setFullscreen(true)
		}, 100)
	})

	onAppHide(() => {
		console.log('App Hide')
		globalState.appActive = false
		stopClock()
	})

	// #ifdef APP-ANDROID
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			exitApp()
		}
	})

	onExit(() => {
		console.log('App Exit')
		stopClock()
		// 注销顺序与 onLaunch 相反：先停上层（巡检、WebSocket、洗护），再关串口，最后释放声音
		monitorController.destroy()
		socketController.destroy()
		washController.destroy()
		serialController.destroy()
		voiceController.destroy()
	})
	// #endif

	onError((err : any) => {
		console.error('App Error', err)
	})
</script>

