import { getErrorMsg, showMsg } from "@/utils/tools.uts"
import { baseUrl } from "@/config.uts"

/**
 * 响应数据结构
 * 蒸汽模式下逻辑层由 js 引擎执行，泛型参数 T 在运行时不存在，
 * 所以这里不用泛型，data 由调用方按具体类型转换（见 tools.uts 的 parseAs 说明）
 */
export type ResponseData = {
	error : number;
	msg : string;
	data : any | null;
}

/** 请求配置 */
export type RequestConfig = {
	url : string;
	method : 'GET' | 'POST';
	data ?: UTSJSONObject;
	timeout ?: number;
	header ?: UTSJSONObject;
}

// 额外的自定义参数
export type Custom = {
	showLoading ?: boolean;
	/** 请求失败时不弹“网络连接失败”提示（用于定时轮询） */
	silent ?: boolean;
}

// Loading全局实例
let LoadingCount :number = 0;

/** 关闭loading */
function closeLoading() {
	if (LoadingCount > 0) LoadingCount--;
	if (LoadingCount === 0) uni.hideLoading();
}


function openLoading() {
	LoadingCount++;
	if (LoadingCount === 1) {
		uni.showLoading({
			title: '加载中...',
			mask: true,
			fail: () => {
				uni.hideLoading();
			},
		});
	}
}

export function request(config : RequestConfig, custom : Custom = {}) : Promise<ResponseData> {
	if (custom.showLoading == true) {
		openLoading()
	}
	return new Promise<ResponseData>((resolve, reject) => {
		const url = config.url.startsWith('http') ? config.url : baseUrl + config.url
		const header = config.header ?? {}
		uni.request<ResponseData>({
			url: url,
			method: config.method,
			data: config.data,
			timeout: config.timeout ?? 60000,
			header: UTSJSONObject.assign({},{
				Accept: 'text/json',
				'Content-Type': 'application/json;charset=UTF-8',
				platform: 'App'
			},header),
			success: (res : RequestSuccess<ResponseData>) => {
				const responseData = res.data
				if (res.statusCode == 200 && responseData != null) {
					if (responseData.error == 0) {
						resolve(responseData);
					} else {
						console.log('error', config.url, res)
						// showMsg(responseData.msg ?? '业务请求失败');
						reject(new Error(responseData.msg ?? '业务错误'));
					}
				} else {
					const msg = getErrorMsg(res.statusCode)
					reject(new Error(`HTTP Error: ${res.statusCode} - ${msg}`));
				}
			},

			fail: (err : RequestFail) => {
				if (custom.silent != true) showMsg('网络连接失败，请稍后重试');
				reject(err);
			},

			complete: (option : any) => {
				if (custom.showLoading == true) {
					closeLoading()
				}
			}

		});
	});
}


/**
 * GET 请求快捷方法
 * @param url 请求地址
 * @param data 请求参数 (自动作为 query string 或 body)
 * @param config 额外的配置，如 showLoading, timeout, header等。
 * 注意：传入 config 中的 url/data/method 参数将被忽略。
 */
export function get(
	url : string,
	data : UTSJSONObject = {},
	custom : Custom = {},
	header : UTSJSONObject = {}
) : Promise<ResponseData> {
	return request({ url: url, data: data, method: 'GET', header: header } as RequestConfig, custom);
}

/**
 * POST 请求快捷方法
 * @param url 请求地址
 * @param data 请求体数据
 * @param config 额外的配置，如 showLoading, timeout, header等。
 * 注意：传入 config 中的 url/data/method 参数将被忽略。
 */
export function post(
	url : string,
	data : UTSJSONObject = {},
	custom : Custom = {},
	header : UTSJSONObject = {}
) : Promise<ResponseData> {
	return request({ url: url, data: data, method: 'POST', header: header } as RequestConfig, custom);
}

export default { request, get, post }