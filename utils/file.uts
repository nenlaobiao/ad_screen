import type { AdItem, dFile, GetMediaInfo } from '@/pages/index/types.uts'
import {ossUrl} from "@/config.uts"
const basePath = uni.env.USER_DATA_PATH


export function cdn(url:string){
	return url.startsWith('http') ?  url : (ossUrl + url)
}
const FS = uni.getFileSystemManager()

/** 获取文件名 */
export function getFileName(url : string) : string {
	const match = url.match(/([^\/]+)$/)
	return match?.[1] ?? ''
}

/** 判断媒体类型 */
function getMediaType(fileName : string) : 'image' | 'video' | 'other' {
	const extension = fileName.split('.').pop()?.toLowerCase() ?? ''
	const imageExtensions = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'svg', 'tiff']
	const videoExtensions = ['mp4', 'avi', 'mov', 'wmv', 'flv', 'mkv', 'webm', '3gp', 'm4v']
	if (imageExtensions.includes(extension)) return 'image'
	if (videoExtensions.includes(extension)) return 'video'
	return 'other'
}

/** 读取缓存数据 */
function loadCache(key:string) : dFile[] {
	const json = uni.getStorageSync(key)
	if (typeof json === 'string' && json.trim() != '') {
		try {
			const parsed = JSON.parse<dFile[]>(json)
			if (Array.isArray(parsed)) return parsed as dFile[]
		} catch (e) {
			console.warn("缓存解析失败:", e)
		}
	}
	return []
}

/** 读取本地广告资源文件名 */
function readLocalFileNames(url:string) : string[] {
	try {
		FS.accessSync(url)
		const files = FS.readdirSync(url)
		return files != null && Array.isArray(files) && files.length > 0 ? files : []
	} catch (e) {
		FS.mkdirSync(url, true)
		return []
	}
}

/** 删除多余的文件 */
function cleanObsoleteFiles(url:string, needed : string[], localFiles : string[]) : number {
	let count = 0
	for (const file of localFiles) {
		if (!needed.includes(file)) {
			try {
				FS.unlinkSync(`${url}${file}`)
				count++
				console.log(`清除本地缓存: ${file}`)
			} catch (e) {
				console.warn(`删除失败: ${file}`, e)
			}
		}
	}
	return count
}

/** 过滤无效缓存项（本地文件不存在） */
function filterValidCache( cacheList : dFile[], localFileNames : string[]) : dFile[] {
	return cacheList.filter(item => {
		return localFileNames.includes(item.fileName)
	})
}

/** 获取需下载的资源 */
function getDownloadList(list : AdItem[], localFileNames : string[]) : AdItem[] {
	return list.filter(item => !localFileNames.includes(getFileName(item.src)))
}

/** 排序合并缓存与新下载的数据 */
function mergeAndSort(list : AdItem[], allFiles : dFile[]) : dFile[] {
	const sortMap = new Map<string, number>()
	list.forEach((item, index) => {
		sortMap.set(getFileName(item.src), index)
	})
	return allFiles.sort((a, b) => {
		return (sortMap.get(a.fileName) ?? Infinity) - (sortMap.get(b.fileName) ?? Infinity)
	})
}

/** 下载缺失资源（并发控制 + 重试） */
async function downloadAD(key:string , url:string, list : AdItem[],cacheRef: dFile[], maxConcurrent = 3, attempt = 3) : Promise<dFile[]> {
	const successList : dFile[] = []
	const tasks : AdItem[] = [...list]

	async function runTask() {
		while (tasks.length > 0) {
			const item = tasks.shift()
			if (item == null) continue
			for (let d = 1; d <= attempt; d++) {
				try {
					console.log(`${d == 1 ? '开始' : '重试'}下载 ${item.src}`)
					const file = await downloadFile(url,item)
					// 及时更新缓存
					cacheRef.push(file)
					uni.setStorageSync(key, JSON.stringify(cacheRef))
					
					successList.push(file)
					break
				} catch (e) {
					if (d === attempt) console.error(`下载失败跳过: ${item.src}`)
				}
			}
		}
	}

	// 同时启动最多 maxConcurrent 个任务
	const tasksList : Promise<void>[] = [];
	for (let i = 0; i < maxConcurrent; i++) {
		tasksList.push(runTask());
	}
	await Promise.all(tasksList);
	return successList
}

/** 单个文件下载及保存 */
function downloadFile(url:string, data : AdItem) : Promise<dFile> {
	return new Promise((resolve, reject) => {
		uni.downloadFile({
			url: cdn(data.src),
			success: (res) => {
				if (res.statusCode == 200) {
					try {
						getMediaInfo(res.tempFilePath, data.type).then((info : GetMediaInfo) => {
							const fileName = getFileName(data.src)
							const file : dFile = {
								data,
								path: FS.saveFileSync(res.tempFilePath, `${url}${fileName}`), // ${fileName}
								fileName,
								mediaInfo: info
							}
							resolve(file)
						}).catch((error) => {
							console.log('getMediaInfo---error',error)
							reject(new Error('媒体信息获取失败'))
						})
					} catch (error) {
						reject(new Error('媒体信息获取失败'))
					}
				} else {
					reject(new Error('下载失败，状态码非200'))
				}
			},
			fail: (err) => {
				reject(new Error(`下载失败: ${err.errMsg}`))
			}
		})
	})
}

/** 获取图片/视频信息 */
function getMediaInfo(src : string, type : string) : Promise<GetMediaInfo> {
	return new Promise((resolve, reject) => {
		const fail = (label : string, err : any) => {
			console.log(`媒体信息获取失败 (${label}), err`,err)
			reject(err)
		}
		if (type == 'image') {
			uni.getImageInfo({ src, success: resolve, fail: err => fail('image', err) })
		} else if (type == 'video') {
			uni.getVideoInfo({ src, success: resolve, fail: err => fail('video', err) })
		} else {
			reject(new Error(`不支持的媒体类型 -- ${type}`))
		}
	})
}

/**
 * 修复/重新下载单个损坏的文件，并返回更新后的完整缓存列表
 * @param brokenFile 损坏的 dFile 对象
 * @returns Promise<dFile[]> 返回更新后的完整列表（如果修复失败，返回原列表）
 */
export async function repairSingleFile(brokenFile : dFile) : Promise<dFile[]> {
	// 1. 提取 type (例如 "ad")
	const typeMatch = brokenFile.path.match(/unifile:\/\/usr\/([^\/]+)\//)
	const type = typeMatch?.[1] ?? 'ad'

	const adFileUrl = `${basePath}${type}/`
	const CACHE_KEY = `AD_CACHE_DATA_${type.toUpperCase()}`
	
	// 2. 加载当前所有缓存
	let currentCache = loadCache(CACHE_KEY)

	try {
		console.log(`[单文件修复] 开始下载: ${brokenFile.fileName}`)

		// 3. 执行强制覆盖下载
		const newFile = await downloadFile(adFileUrl, brokenFile.data)
		console.log(`[newFile]`,newFile)
		// 4. 更新数组中的对应项
		const index = currentCache.findIndex(item => item.fileName === newFile.fileName)
		if (index !== -1) {
			currentCache[index] = newFile
		} else {
			// 如果缓存里竟然没这个文件，就加进去
			currentCache.push(newFile)
		}

		// 5. 持久化并保存排序结果（如果有排序需求，建议此处保持原顺序）
		uni.setStorageSync(CACHE_KEY, JSON.stringify(currentCache))
		
		console.log(`[修复成功] 记录已更新`)
		return currentCache

	} catch (e) {
		console.error(`[修复失败] ${brokenFile.fileName}:`, e)
		// 如果修复失败，返回未修改的原始缓存列表
		return currentCache
	}
}

/**
 * 文件统一下载管理
 * @param {Array}list 文件列表 
 * @param {String} type 储存文件夹
 */
export default async function fileManage(list : AdItem[], type:string = 'ad') : Promise<dFile[]> {
	const adFileUrl = `${basePath}${type}/`
	const AD_FOLDER_NAME = type
	const CACHE_KEY = `AD_CACHE_DATA_${AD_FOLDER_NAME}`
	const cached = loadCache(CACHE_KEY)
	const localFiles = readLocalFileNames(adFileUrl)
	const neededFileNames = list.map(item => getFileName(item.src))
	const deletedCount = cleanObsoleteFiles(adFileUrl, neededFileNames, localFiles)
	let validCache = filterValidCache(cached, localFiles)
	const cacheNum = validCache.length
	const toDownload = getDownloadList(list, localFiles)
	const downloaded = await downloadAD(CACHE_KEY,adFileUrl, toDownload,validCache)
	
	const merged = mergeAndSort(list, validCache)

	console.log(`${type} --> 读取缓存:${cacheNum}，下载:${downloaded.length}，删除:${deletedCount}`)
	uni.setStorageSync(adFileUrl, JSON.stringify(merged))
	return merged
}