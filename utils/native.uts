// #ifdef APP-ANDROID
import Build from 'android.os.Build';
import WindowManager from 'android.view.WindowManager';
import File from 'java.io.File';
import View from 'android.view.View';
import WindowInsets from 'android.view.WindowInsets';
import WindowInsetsController from 'android.view.WindowInsetsController';
import Color from 'android.graphics.Color';
import Runtime from 'java.lang.Runtime';
import BufferedReader from 'java.io.BufferedReader';
import InputStreamReader from 'java.io.InputStreamReader';
import DataOutputStream from 'java.io.DataOutputStream';
// #endif

/**
 * 全屏沉浸模式
 */
export function setFullscreen(enable: boolean = true) {
    // #ifdef APP-ANDROID
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) return;
    const window = activity.getWindow();
    const decorView = window.getDecorView();

    activity.runOnUiThread(() => {
        if (enable) {
            // 1. 【核心：针对 Android 8.1 的白边修复】
            // 允许窗口延伸到屏幕范围之外（忽略导航栏占位）
            window.addFlags(WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS);
            window.addFlags(WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN);
            
            // 2. 强制设置透明背景，防止系统默认层出现白边
            window.addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);
            window.setStatusBarColor(Color.TRANSPARENT);
            window.setNavigationBarColor(Color.TRANSPARENT);

            // 3. 经典的沉浸式 Flag 组合
            // 使用 SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION 是消除白边的关键
            let flags = View.SYSTEM_UI_FLAG_LAYOUT_STABLE |
                        View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION |
                        View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN |
                        View.SYSTEM_UI_FLAG_HIDE_NAVIGATION |
                        View.SYSTEM_UI_FLAG_FULLSCREEN |
                        View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY;

            // @ts-ignore
            decorView.setSystemUiVisibility(flags);

            // 4. 适配 Android 11+ (API 30+)
            if (Build.VERSION.SDK_INT >= 30) {
                window.setDecorFitsSystemWindows(false);
                const controller = window.getInsetsController();
                if (controller != null) {
                    controller.hide(WindowInsets.Type.statusBars() | WindowInsets.Type.navigationBars());
                    controller.setSystemBarsBehavior(WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
                }
            }
        } else {
            // 退出全屏恢复默认
            window.clearFlags(WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS);
            // @ts-ignore
            decorView.setSystemUiVisibility(View.SYSTEM_UI_FLAG_VISIBLE);
        }
    });
    // #endif
}
/**
 * 执行 Root 命令
 * @param cmd 命令字符串
 */
export function execRootShell(cmd: string): Promise<string> {
    return new Promise((resolve, reject) => {
        // #ifdef APP-ANDROID
        try {
            // 使用字符串数组方式执行，防止空格参数失效
            const process = Runtime.getRuntime().exec("su");
            const os = new DataOutputStream(process.getOutputStream());
            
            // 写入命令并换行
            os.writeBytes(cmd + "\n");
            os.writeBytes("exit\n");
            os.flush();

            const reader = new BufferedReader(new InputStreamReader(process.getInputStream()));
            let output = "";
            
            // UTS 循环安全写法
            while (true) {
                const line = reader.readLine();
                if (line == null) break;
                output += line + "\n";
            }

            process.waitFor();
            resolve(output.trim());
        } catch (e) {
            reject(`Root 执行失败: ${e}`);
        }
        // #endif

        // #ifndef APP-ANDROID
        reject("非 Android 环境不支持 Root 操作");
        // #endif
    });
}

/**
 * 静默安装 APK (需 Root)
 * @param apkPath APK 文件在手机里的绝对路径
 */
export async function silentInstall(apkPath: string): Promise<boolean> {
    try {
        // pm install -r 强制覆盖安装
        const result = await execRootShell(`pm install -r ${apkPath}`);
        return result.toLowerCase().includes("success");
    } catch (e) {
        console.error("静默安装失败:", e);
        return false;
    }
}

/**
 * 静默重启设备 (需 Root)
 */
export async function rebootDevice() {
    return await execRootShell("reboot");
}


/**
 * 检测设备是否具有 Root 权限
 * @returns boolean
 */
export function isDeviceRooted() : boolean {
	// #ifdef APP-ANDROID
	// 方法 1: 检查常见的 su 文件路径
	const paths = [
		"/system/bin/su",
		"/system/xbin/su",
		"/sbin/su",
		"/system/sd/xbin/su",
		"/unused/bin/su",
		"/data/local/xbin/su",
		"/data/local/bin/su",
		"/system/usr/we-need-app/su",
		"/cache/su",
		"/bin/su",
		"/sbin/su"
	];

	for (let path in paths) {
		const file = new File(path);
		if (file.exists()) return true;
	}

	// 方法 2: 尝试执行 check-in (有些设备做了隐藏，但执行命令骗不了人)
	return checkRootMethod2();
	// #endif
	
	return false;
}

/**
 * 尝试通过执行 su 命令来检测
 */
function checkRootMethod2() : boolean {
	let process : Process | null = null;
	try {
		// 执行 id 命令，如果返回包含 uid=0 则说明是 root
		process = Runtime.getRuntime().exec("su -c id");
		const reader = new BufferedReader(new InputStreamReader(process!.getInputStream()));
		const output = reader.readLine();
		if (output != null && output.toLowerCase().includes("uid=0")) {
			return true;
		}
	} catch (e) {
		// 执行失败说明没有 su 环境
	} finally {
		if (process != null) {
			process.destroy();
		}
	}
	return false;
}