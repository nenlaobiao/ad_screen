// #ifdef APP-ANDROID
import Build from 'android.os.Build';
import WindowManager from 'android.view.WindowManager';
import View from 'android.view.View';
import WindowInsets from 'android.view.WindowInsets';
import WindowInsetsController from 'android.view.WindowInsetsController';
import Color from 'android.graphics.Color';
import Runtime from 'java.lang.Runtime';
import BufferedReader from 'java.io.BufferedReader';
import InputStreamReader from 'java.io.InputStreamReader';
// #endif

/**
 * 跨版本沉浸模式
 * Android 8+ 到 Android 13+
 */
export function setFullscreen(enable: boolean = true) {
    // #ifdef APP-ANDROID
    let activity = UTSAndroid.getUniActivity()!;
    let window = activity.getWindow();

    if (Build.VERSION.SDK_INT >= 30) {
        // Android 11+
        let controller = window.getInsetsController();
        if (controller != null) {
            if (enable) {
                controller.hide(
                    WindowInsets.Type.statusBars() | WindowInsets.Type.navigationBars()
                );
                controller.setSystemBarsBehavior(
                    WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
                );
                window.setDecorFitsSystemWindows(false);
                window.setNavigationBarColor(Color.TRANSPARENT);
            } else {
                controller.show(
                    WindowInsets.Type.statusBars() | WindowInsets.Type.navigationBars()
                );
                controller.setSystemBarsBehavior(WindowInsetsController.BEHAVIOR_DEFAULT);
                window.setDecorFitsSystemWindows(true);
            }
        }
    } else if (Build.VERSION.SDK_INT >= 19) {
        // Android 4.4 ~ Android 10，用老方法
        let decorView = window.getDecorView();
        if (enable) {
            // 沉浸模式
            // @ts-ignore
            decorView.setSystemUiVisibility(
                // @ts-ignore
                View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
                | View.SYSTEM_UI_FLAG_FULLSCREEN
            );
            window.addFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN);
        } else {
            // 恢复
            // @ts-ignore
            decorView.setSystemUiVisibility(View.SYSTEM_UI_FLAG_VISIBLE);
            window.clearFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN);
        }
    }
    // #endif
}
// utils/rootShell.uts
export function execRootShell(cmd: string): Promise<string> {
  return new Promise((resolve, reject) => {
    try {
      // #ifdef APP-ANDROID
      const process = Runtime.getRuntime()!.exec("su -c '" + cmd + "'");
      const inputStream = process.getInputStream();
      const reader = new BufferedReader(new InputStreamReader(inputStream));
      let output = "";
      let line: string | null = reader.readLine();

      // 读取命令输出
      while (line != null) {
        output += line + "\n";
        line = reader.readLine();
      }

      // 等待命令结束
      process.waitFor();
      resolve(output.trim());
      // #endif

      // #ifdef H5 || APP-PLUS
      reject("仅支持 Android 设备并且已 Root");
      // #endif
    } catch (e) {
      reject(e);
    }
  });
}
