import type { GlobalState } from "./types.uts"

export const globalState = reactive<GlobalState>({
	deviceData: {
		mode: 'dry',
		status: 110,
		cage: 30.2,
		water: 30.2,
		petWeight: 0,
		countdownTime: 0,
		fault: 0,
		liquidLevel: 0,
	},
	// 从串口读到设备号后才会写入，WebSocket 会等它非空再连接
	machineCode: '',
	order_id: '',
	serviceStatus: false,
	serialStatus: false,
	appVersion: '0.0.0',
	updating: false,
	nowTime: Date.now(),
	adList: [],
	networkConnected: true,
	appActive: true,
	paidWaiting: false,
	takePet: false,
	formatMachineCode: '',
})
export const setCage = (num : number) => {
	globalState.deviceData.cage = num
}
